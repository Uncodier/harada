# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Vercel AI Gateway Configuration
# This should be your Vercel AI Gateway API key (starts with vck_)
# Get it from: https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase URL Configuration
# In Supabase Dashboard -> Authentication -> URL Configuration:
# 
# Site URL (for development):
#   http://localhost:3000
# 
# Site URL (for production):
#   https://your-production-domain.com
#
# Redirect URLs (add all of these):
#   http://localhost:3000/dashboard
#   http://localhost:3000/auth/callback
#   https://your-production-domain.com/dashboard
#   https://your-production-domain.com/auth/callback
#
# Email Templates Configuration:
#   Confirm signup: {{ .SiteURL }}/auth/callback?token={{ .TokenHash }}&type=email
#   Reset password: {{ .SiteURL }}/auth/callback?token={{ .TokenHash }}&type=recovery
#   Magic Link: {{ .SiteURL }}/auth/callback?token={{ .TokenHash }}&type=magiclink

